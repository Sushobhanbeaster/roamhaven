<% layout("/layouts/boilerplate") %>

<div class="recommendations-container">
  <!-- Hero Section -->
  <div class="rec-hero py-4 mb-4">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-2">
          <i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI-Powered Matching Algorithm
        </span>
        <h2 class="fw-bold display-6 mb-2">Smart Stay Recommendation System</h2>
        <p class="text-muted fs-6 mb-0">
          Tell us your budget, desired city, stay style, and must-have amenities. Our multi-factor ranking algorithm scores and delivers the most tailored stays for your journey.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/budget-planner" class="btn btn-outline-dark rounded-pill me-2">
          <i class="fa-solid fa-calculator me-1"></i> Trip Budget Planner
        </a>
        <a href="/map" class="btn btn-outline-danger rounded-pill">
          <i class="fa-solid fa-map me-1"></i> Explore Map
        </a>
      </div>
    </div>
  </div>

  <!-- Smart Preferences Form -->
  <div class="card filter-wizard-card border-0 shadow-sm rounded-4 p-4 mb-5">
    <form action="/recommendations" method="GET" id="recForm">
      <div class="row g-3">
        <!-- Destination -->
        <div class="col-md-4">
          <label class="form-label fw-bold d-flex align-items-center justify-content-between">
            <span><i class="fa-solid fa-location-dot text-danger me-1"></i> Preferred Destination</span>
            <small class="text-muted fw-normal">City or Country</small>
          </label>
          <input 
            type="text" 
            name="destination" 
            id="destinationInput" 
            class="form-control rounded-3" 
            placeholder="e.g. Bhubaneswar, Malibu, Aspen..." 
            value="<%= filters.destination %>"
          />
          <!-- Quick Destination Pills -->
          <div class="d-flex flex-wrap gap-1 mt-2">
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setDestination('Bhubaneswar')">Bhubaneswar</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setDestination('Malibu')">Malibu</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setDestination('Florence')">Florence</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setDestination('Kyoto')">Kyoto</button>
          </div>
        </div>

        <!-- Nightly Budget -->
        <div class="col-md-4">
          <label class="form-label fw-bold d-flex align-items-center justify-content-between">
            <span><i class="fa-solid fa-indian-rupee-sign text-success me-1"></i> Max Nightly Budget</span>
            <span class="badge bg-success-subtle text-success fw-semibold" id="budgetValueBadge">
              &#8377;<%= filters.budget ? Number(filters.budget).toLocaleString("en-IN") : "2,000" %>
            </span>
          </label>
          <div class="d-flex align-items-center gap-2">
            <input 
              type="range" 
              class="form-range" 
              name="budget" 
              id="budgetSlider" 
              min="800" 
              max="6000" 
              step="100" 
              value="<%= filters.budget || 2000 %>"
              oninput="syncBudget(this.value)"
            />
          </div>
          <!-- Quick Budget Buttons -->
          <div class="d-flex flex-wrap gap-1 mt-1">
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setBudget(1500)">&#8377;1,500</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setBudget(2000)">&#8377;2,000</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setBudget(3000)">&#8377;3,000</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 text-muted" onclick="setBudget(4500)">&#8377;4,500</button>
          </div>
        </div>

        <!-- Property Type -->
        <div class="col-md-4">
          <label class="form-label fw-bold">
            <i class="fa-solid fa-house-chimney text-primary me-1"></i> Property Style
          </label>
          <select name="propertyType" class="form-select rounded-3">
            <option value="Any" <%= filters.propertyType === 'Any' ? 'selected' : '' %>>Any Property Type</option>
            <option value="Apartment" <%= filters.propertyType === 'Apartment' ? 'selected' : '' %>>Apartment</option>
            <option value="Villa" <%= filters.propertyType === 'Villa' ? 'selected' : '' %>>Villa</option>
            <option value="Cottage" <%= filters.propertyType === 'Cottage' ? 'selected' : '' %>>Cottage</option>
            <option value="Chalet" <%= filters.propertyType === 'Chalet' ? 'selected' : '' %>>Chalet</option>
            <option value="Loft" <%= filters.propertyType === 'Loft' ? 'selected' : '' %>>Loft</option>
            <option value="Treehouse" <%= filters.propertyType === 'Treehouse' ? 'selected' : '' %>>Treehouse</option>
            <option value="Cabin" <%= filters.propertyType === 'Cabin' ? 'selected' : '' %>>Cabin</option>
            <option value="Ryokan" <%= filters.propertyType === 'Ryokan' ? 'selected' : '' %>>Ryokan</option>
          </select>
        </div>

        <!-- Amenities Multi-Select -->
        <div class="col-12 mt-3">
          <label class="form-label fw-bold mb-2">
            <i class="fa-solid fa-sparkles text-warning me-1"></i> Must-Have Amenities
          </label>
          <div class="d-flex flex-wrap gap-2">
            <% 
              const availableAmenities = [
                { name: "Wifi", icon: "fa-wifi" },
                { name: "Free Parking", icon: "fa-square-parking" },
                { name: "Air Conditioning", icon: "fa-snowflake" },
                { name: "Kitchen", icon: "fa-utensils" },
                { name: "Dedicated Workspace", icon: "fa-laptop" },
                { name: "Swimming Pool", icon: "fa-person-swimming" },
                { name: "Pet Friendly", icon: "fa-paw" },
                { name: "TV", icon: "fa-tv" }
              ];
            %>
            <% for(let a of availableAmenities) { 
                const isChecked = filters.amenities && filters.amenities.includes(a.name);
            %>
              <label class="amenity-checkbox-pill <%= isChecked ? 'checked' : '' %>">
                <input 
                  type="checkbox" 
                  name="amenities" 
                  value="<%= a.name %>" 
                  <%= isChecked ? 'checked' : '' %>
                  onchange="this.parentElement.classList.toggle('checked', this.checked)"
                />
                <i class="fa-solid <%= a.icon %> me-1"></i> <%= a.name %>
              </label>
            <% } %>
          </div>
        </div>

        <div class="col-12 text-end mt-3">
          <a href="/recommendations" class="btn btn-outline-secondary rounded-pill me-2">Reset</a>
          <button type="submit" class="btn btn-theme px-4 rounded-pill">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Find Best Matches
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Recommendation Results -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="fw-bold m-0">
      Recommended Stays Ranked For You 
      <span class="badge bg-secondary-subtle text-dark fs-6 ms-2"><%= results.length %> Matches</span>
    </h4>
    <small class="text-muted">Ranked by score weighting destination, budget proximity & amenity overlap</small>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <% for(let item of results) { 
        const { listing, matchScore, reasons, matchedAmenities } = item;
        let scoreBadgeClass = "bg-success";
        if(matchScore < 70) scoreBadgeClass = "bg-warning text-dark";
        if(matchScore < 50) scoreBadgeClass = "bg-secondary";
    %>
      <div class="col">
        <div class="card listing-card h-100 shadow-sm border-0 position-relative">
          <!-- Top Match Badge -->
          <div class="match-score-badge <%= scoreBadgeClass %> shadow-sm">
            <i class="fa-solid fa-bolt me-1"></i> <%= matchScore %>% Match
          </div>

          <div class="card-img-wrapper">
            <img 
              src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1625244724120-1fd1d34d00f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" 
              class="card-img-top" 
              alt="<%= listing.title %>"
            />
            <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-0 m-2 px-2 py-1 rounded">
              <i class="fa-solid fa-house me-1"></i> <%= listing.propertyType || 'Stay' %>
            </span>
          </div>

          <div class="card-body d-flex flex-direction-column flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h5 class="card-title fw-bold m-0 text-truncate" title="<%= listing.title %>">
                  <%= listing.title %>
                </h5>
                <span class="text-warning fw-semibold fs-6 ms-2 text-nowrap">
                  <i class="fa-solid fa-star"></i> 
                  <%= listing.reviews && listing.reviews.length > 0 
                      ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1)
                      : "New" %>
                </span>
              </div>
              <p class="card-location text-muted small mb-2">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
              </p>

              <!-- Scoring Reasons / Highlights -->
              <div class="rec-reasons mb-2">
                <% for(let reason of reasons.slice(0, 2)) { %>
                  <span class="badge bg-light text-dark border me-1 mb-1">
                    <i class="fa-solid fa-check text-success me-1"></i> <%= reason %>
                  </span>
                <% } %>
              </div>

              <!-- Amenities tags -->
              <div class="d-flex flex-wrap gap-1 mb-3">
                <% for(let amenity of (listing.amenities || []).slice(0, 3)) { %>
                  <span class="badge rounded-pill <%= matchedAmenities.includes(amenity) ? 'bg-primary-subtle text-primary border border-primary' : 'bg-light text-muted' %>" style="font-size: 0.72rem;">
                    <%= amenity %>
                  </span>
                <% } %>
                <% if ((listing.amenities || []).length > 3) { %>
                  <span class="badge rounded-pill bg-light text-muted" style="font-size: 0.72rem;">+<%= (listing.amenities.length - 3) %> more</span>
                <% } %>
              </div>
            </div>

            <div>
              <div class="d-flex align-items-baseline justify-content-between pt-2 border-top">
                <div class="card-price m-0">
                  <span class="fs-5 fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span>
                  <span class="text-muted small">/ night</span>
                </div>
                <div class="d-flex gap-2">
                  <button 
                    class="btn btn-sm btn-outline-secondary rounded-pill btn-compare-toggle"
                    data-id="<%= listing._id %>"
                    onclick="toggleCompare('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', '<%= listing.image && listing.image.url ? listing.image.url : '' %>', <%= listing.price || 0 %>)"
                  >
                    <i class="fa-solid fa-plus me-1"></i> Compare
                  </button>
                  <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-theme rounded-pill px-3">
                    View
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  function syncBudget(val) {
    document.getElementById("budgetValueBadge").innerText = "₹" + Number(val).toLocaleString("en-IN");
  }

  function setBudget(val) {
    const slider = document.getElementById("budgetSlider");
    slider.value = val;
    syncBudget(val);
  }

  function setDestination(city) {
    document.getElementById("destinationInput").value = city;
  }
</script>
