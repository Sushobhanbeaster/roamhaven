<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-3">
  <div class="col-12 col-lg-11">
    <!-- Title & Top Meta -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
      <div>
        <h2 class="fw-bold m-0"><%= listing.title %></h2>
        <p class="text-muted small m-0">
          <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %>, <%= listing.country %>
          &bull; 
          <span class="text-warning fw-semibold">
            <i class="fa-solid fa-star"></i> 
            <%= listing.reviews && listing.reviews.length > 0 
                ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1)
                : "New" %>
          </span>
          <span class="text-muted">(<%= listing.reviews ? listing.reviews.length : 0 %> reviews)</span>
          &bull;
          <span class="badge bg-secondary-subtle text-dark"><%= listing.propertyType || 'Stay' %></span>
        </p>
      </div>

      <div class="d-flex gap-2">
        <button 
          class="btn btn-outline-secondary rounded-pill btn-compare-toggle"
          data-id="<%= listing._id %>"
          onclick="toggleCompare('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', '<%= listing.image && listing.image.url ? listing.image.url : '' %>', <%= listing.price || 0 %>);"
        >
          <i class="fa-solid fa-plus me-1"></i> Compare Stays
        </button>
        <a href="/listings" class="btn btn-outline-dark rounded-pill">
          <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
      </div>
    </div>

    <!-- Hero Image Gallery -->
    <div class="card border-0 mb-4 rounded-4 overflow-hidden shadow-sm">
      <img 
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1625244724120-1fd1d34d00f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" 
        class="card-img-top show-img" 
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Main Content: Left Details, Right Sticky Budget Calculator -->
    <div class="row g-4 mb-5">
      <!-- Left Column: Details, Amenities, Location Map & Reviews -->
      <div class="col-lg-7">
        <!-- Hosted info & Overview -->
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
          <div>
            <h5 class="fw-bold mb-1">Entire <%= listing.propertyType || 'Stay' %> hosted by Premier Host</h5>
            <p class="text-muted small mb-0">
              Up to <%= listing.maxGuests || 4 %> guests &bull; 2 bedrooms &bull; 2 beds &bull; Dedicated bath
            </p>
          </div>
          <i class="fa-solid fa-circle-user display-6 text-secondary"></i>
        </div>

        <!-- Description -->
        <div class="mb-4">
          <h5 class="fw-bold mb-2">About this space</h5>
          <p class="card-text text-secondary fs-6 leading-relaxed">
            <%= listing.description %>
          </p>
        </div>

        <hr>

        <!-- Feature 1 & 4 Amenity Highlights -->
        <div class="mb-4">
          <h5 class="fw-bold mb-3">What this place offers</h5>
          <div class="row row-cols-2 g-3">
            <% 
              const iconMap = {
                "wifi": "fa-wifi",
                "free parking": "fa-square-parking",
                "air conditioning": "fa-snowflake",
                "kitchen": "fa-utensils",
                "dedicated workspace": "fa-laptop",
                "swimming pool": "fa-person-swimming",
                "pet friendly": "fa-paw",
                "tv": "fa-tv"
              };
            %>
            <% for (let amenity of (listing.amenities || ["Wifi", "Air Conditioning", "Free Parking"])) { 
                const icon = iconMap[amenity.toLowerCase()] || "fa-check";
            %>
              <div class="col d-flex align-items-center gap-2">
                <i class="fa-solid <%= icon %> text-danger fs-5" style="width: 25px;"></i>
                <span class="fw-medium"><%= amenity %></span>
              </div>
            <% } %>
          </div>
        </div>

        <hr>

        <!-- Cancellation Policy & Nearby Hubs -->
        <div class="mb-4">
          <h5 class="fw-bold mb-3">Cancellation & Key Landmarks</h5>
          <div class="bg-light rounded-4 p-3 mb-3">
            <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-shield-halved text-success me-1"></i> Cancellation Policy</h6>
            <p class="text-muted small mb-0"><%= listing.cancellationPolicy || "Flexible (Free cancellation up to 48 hrs before check-in)" %></p>
          </div>

          <% if (listing.nearbyHubs && listing.nearbyHubs.length > 0) { %>
            <h6 class="fw-bold mb-2">Nearby Transit & Attractions</h6>
            <div class="d-flex flex-wrap gap-2">
              <% for(let hub of listing.nearbyHubs) { %>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                  <i class="fa-solid fa-compass text-danger me-1"></i> <%= hub %>
                </span>
              <% } %>
            </div>
          <% } %>
        </div>

        <hr>

        <!-- Feature 3: Interactive Leaflet Location Map -->
        <div class="mb-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="fw-bold m-0">Where you'll be</h5>
              <p class="text-muted small mb-0"><%= listing.location %>, <%= listing.country %></p>
            </div>
            <a href="/map" class="btn btn-sm btn-outline-danger rounded-pill">Open Full Map</a>
          </div>

          <div id="singlePropertyMap" class="rounded-4 shadow-sm" style="height: 320px; width: 100%;"></div>
        </div>

        <hr>

        <!-- Actions -->
        <div class="btns mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark-custom rounded-pill">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-outline-danger rounded-pill" onclick="return confirm('Are you sure you want to delete this listing?')">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column: SMART TRIP BUDGET CALCULATOR & INSTANT BOOK -->
      <div class="col-lg-5">
        <div class="card budget-calculator-widget shadow rounded-4 border-0 p-4 sticky-top" style="top: 6.5rem; z-index: 10;">
          <div class="d-flex align-items-baseline justify-content-between mb-3">
            <div>
              <span class="fs-4 fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
              <span class="text-muted small">/ night</span>
            </div>
            <span class="text-warning small fw-semibold">
              <i class="fa-solid fa-star"></i> 
              <%= listing.reviews && listing.reviews.length > 0 
                  ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1)
                  : "New" %>
            </span>
          </div>

          <div class="booking-dates-box border rounded-3 p-2 mb-3 bg-white">
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label text-muted small fw-bold mb-0">CHECK-IN</label>
                <input type="date" id="calcCheckIn" class="form-control form-control-sm border-0 px-0 fw-semibold" onchange="calculateLiveBudget()" />
              </div>
              <div class="col-6 border-start ps-2">
                <label class="form-label text-muted small fw-bold mb-0">CHECK-OUT</label>
                <input type="date" id="calcCheckOut" class="form-control form-control-sm border-0 px-0 fw-semibold" onchange="calculateLiveBudget()" />
              </div>
            </div>
            <div class="border-top pt-2">
              <label class="form-label text-muted small fw-bold mb-0">GUESTS</label>
              <select id="calcGuests" class="form-select form-select-sm border-0 px-0 fw-semibold" onchange="calculateLiveBudget()">
                <% for (let i = 1; i <= (listing.maxGuests || 4); i++) { %>
                  <option value="<%= i %>" <%= i === 2 ? 'selected' : '' %>><%= i %> <%= i === 1 ? 'Guest' : 'Guests' %></option>
                <% } %>
              </select>
            </div>
          </div>

          <!-- Total Trip Budget Input -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted d-flex justify-content-between">
              <span>MY TRIP BUDGET (OPTIONAL)</span>
              <small class="text-primary">Evaluates Budget Fit</small>
            </label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light border-end-0">&#8377;</span>
              <input 
                type="number" 
                id="calcBudget" 
                class="form-control border-start-0" 
                placeholder="e.g. 8000" 
                oninput="calculateLiveBudget()"
              />
            </div>
          </div>

          <!-- Dynamic Budget Fit Alert -->
          <div id="budgetFitBadge" class="alert py-2 px-3 small rounded-3 d-none mb-3"></div>

          <!-- Detailed Cost Breakdown -->
          <div class="cost-breakdown-box bg-light rounded-3 p-3 small mb-3">
            <div class="d-flex justify-content-between mb-2 text-muted">
              <span id="labelNightlyCalc">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %> &times; 3 nights</span>
              <span id="valNightlyCalc" class="text-dark fw-medium">&#8377;<%= ((listing.price || 0) * 3).toLocaleString("en-IN") %></span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted" id="extraGuestRow" style="display: none !important;">
              <span>Extra guest charges</span>
              <span id="valExtraGuest" class="text-dark fw-medium">&#8377;0</span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>Cleaning fee</span>
              <span id="valCleaningFee" class="text-dark fw-medium">&#8377;<%= (listing.cleaningFee || 500).toLocaleString("en-IN") %></span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>RoamHaven service fee (5%)</span>
              <span id="valServiceFee" class="text-dark fw-medium">&#8377;<%= Math.round((listing.price || 0) * 3 * 0.05).toLocaleString("en-IN") %></span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>Taxes (18% GST)</span>
              <span id="valGst" class="text-dark fw-medium">&#8377;0</span>
            </div>

            <hr class="my-2">

            <div class="d-flex justify-content-between fs-6 fw-bold text-dark">
              <span>Total Estimated Stay:</span>
              <span id="valGrandTotal" class="text-danger">&#8377;0</span>
            </div>
          </div>

          <div class="d-grid gap-2">
            <button class="btn btn-theme py-2 fs-6 rounded-pill shadow-sm" type="button" onclick="openBookingModal()">
              <i class="fa-solid fa-calendar-check me-1"></i> Reserve / Instant Book
            </button>
            <a href="/budget-planner" class="btn btn-outline-secondary py-2 small rounded-pill">
              <i class="fa-solid fa-calculator me-1"></i> Open Trip Budget Planner
            </a>
          </div>
          <small class="text-muted text-center d-block mt-2">Saved directly to database &bull; Free cancellation</small>
        </div>
      </div>
    </div>

    <!-- Booking Reservation Modal -->
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
          <!-- Modal Header -->
          <div class="modal-header border-bottom py-3 px-4 bg-light">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-calendar-check text-danger fs-4"></i>
              <div>
                <h5 class="modal-title fw-bold m-0" id="bookingModalLabel">Confirm Your Reservation</h5>
                <small class="text-muted">Review dates, guest info & lock in your stay</small>
              </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <!-- Modal Body Form -->
          <form action="/listings/<%= listing._id %>/book" method="POST" class="needs-validation" novalidate id="bookingForm">
            <div class="modal-body p-4">
              <div class="row g-4">
                <!-- Left Column: Guest Details Form -->
                <div class="col-md-7">
                  <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-user me-2 text-danger"></i>Traveler Information</h6>

                  <div class="mb-3">
                    <label for="bookGuestName" class="form-label small fw-semibold">Full Name</label>
                    <input 
                      type="text" 
                      name="booking[guestName]" 
                      id="bookGuestName" 
                      class="form-control rounded-3" 
                      placeholder="e.g. Priyanshu Sharma" 
                      required 
                    />
                    <div class="invalid-feedback">Please provide your full name.</div>
                  </div>

                  <div class="row g-2 mb-3">
                    <div class="col-md-6">
                      <label for="bookGuestEmail" class="form-label small fw-semibold">Email Address</label>
                      <input 
                        type="email" 
                        name="booking[guestEmail]" 
                        id="bookGuestEmail" 
                        class="form-control rounded-3" 
                        placeholder="name@example.com" 
                        required 
                      />
                      <div class="invalid-feedback">Valid email required.</div>
                    </div>

                    <div class="col-md-6">
                      <label for="bookGuestPhone" class="form-label small fw-semibold">Phone Number</label>
                      <input 
                        type="tel" 
                        name="booking[guestPhone]" 
                        id="bookGuestPhone" 
                        class="form-control rounded-3" 
                        placeholder="+91 98765 43210" 
                        required 
                      />
                      <div class="invalid-feedback">Contact number required.</div>
                    </div>
                  </div>

                  <!-- Synchronized Dates & Guests -->
                  <h6 class="fw-bold text-dark mt-4 mb-3"><i class="fa-solid fa-clock me-2 text-danger"></i>Trip Dates & Guests</h6>
                  <div class="row g-2 mb-3">
                    <div class="col-6">
                      <label class="form-label small fw-semibold">Check-In</label>
                      <input 
                        type="date" 
                        name="booking[checkIn]" 
                        id="modalCheckIn" 
                        class="form-control rounded-3" 
                        required 
                        onchange="syncModalDates()"
                      />
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold">Check-Out</label>
                      <input 
                        type="date" 
                        name="booking[checkOut]" 
                        id="modalCheckOut" 
                        class="form-control rounded-3" 
                        required 
                        onchange="syncModalDates()"
                      />
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Number of Guests</label>
                    <select name="booking[guests]" id="modalGuests" class="form-select rounded-3" onchange="syncModalDates()">
                      <% for (let i = 1; i <= (listing.maxGuests || 4); i++) { %>
                        <option value="<%= i %>"><%= i %> <%= i === 1 ? 'Guest' : 'Guests' %></option>
                      <% } %>
                    </select>
                  </div>

                  <div class="mb-3">
                    <label for="modalSpecialRequests" class="form-label small fw-semibold">Special Requests (Optional)</label>
                    <textarea 
                      name="booking[specialRequests]" 
                      id="modalSpecialRequests" 
                      rows="2" 
                      class="form-control rounded-3" 
                      placeholder="Early check-in, arrival note, or special preferences..."
                    ></textarea>
                  </div>
                </div>

                <!-- Right Column: Stay Preview & Live Cost Slip -->
                <div class="col-md-5">
                  <div class="p-3 bg-light rounded-4 border">
                    <div class="d-flex gap-2 align-items-center mb-3">
                      <img 
                        src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" 
                        alt="<%= listing.title %>" 
                        class="rounded-3 shadow-sm"
                        style="width: 70px; height: 60px; object-fit: cover;"
                      />
                      <div class="overflow-hidden">
                        <h6 class="fw-bold text-truncate mb-0" title="<%= listing.title %>"><%= listing.title %></h6>
                        <small class="text-muted"><i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %></small>
                      </div>
                    </div>

                    <div class="py-2 border-top border-bottom small">
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted" id="modalNightlyLabel">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %> &times; 3 nights</span>
                        <span class="fw-semibold text-dark" id="modalNightlyVal">&#8377;0</span>
                      </div>
                      <div class="d-flex justify-content-between mb-1" id="modalExtraGuestRow" style="display: none;">
                        <span class="text-muted">Extra guest fee</span>
                        <span class="fw-semibold text-dark" id="modalExtraGuestVal">&#8377;0</span>
                      </div>
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Cleaning fee</span>
                        <span class="fw-semibold text-dark">&#8377;<%= (listing.cleaningFee || 500).toLocaleString("en-IN") %></span>
                      </div>
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Service fee (5%)</span>
                        <span class="fw-semibold text-dark" id="modalServiceFeeVal">&#8377;0</span>
                      </div>
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Taxes (18% GST)</span>
                        <span class="fw-semibold text-dark" id="modalGstVal">&#8377;0</span>
                      </div>
                      <hr class="my-2">
                      <div class="d-flex justify-content-between fs-6 fw-bold text-dark">
                        <span>Total Due:</span>
                        <span class="text-danger" id="modalGrandTotalVal">&#8377;0</span>
                      </div>
                    </div>

                    <div class="mt-3">
                      <div class="d-flex align-items-center gap-2 text-success small mb-2">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Free cancellation up to 48 hrs</span>
                      </div>
                      <div class="d-flex align-items-center gap-2 text-muted small">
                        <i class="fa-solid fa-database text-primary"></i>
                        <span>Instant reservation saved to DB</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="modal-footer bg-light px-4 py-3 border-top">
              <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-theme rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-lock me-1"></i> Confirm & Book Reservation
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <hr>

    <!-- Reviews Section -->
    <div class="mt-4 mb-5" id="reviewsSection">
      <!-- Ratings Summary Banner -->
      <% 
        const reviewList = listing.reviews || [];
        const hasReviews = reviewList.length > 0;
        const avgScore = hasReviews 
          ? (reviewList.reduce((acc, r) => acc + r.rating, 0) / reviewList.length).toFixed(1)
          : "New";
      %>

      <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 border-bottom mb-4 gap-3">
        <div>
          <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="fa-solid fa-star text-warning"></i>
            <span><%= avgScore %></span>
            <span class="text-muted fw-normal fs-5">&bull; <%= reviewList.length %> <%= reviewList.length === 1 ? 'Review' : 'Reviews' %></span>
          </h4>
          <p class="text-muted small mb-0">Guest feedback verified from travelers who completed their stay</p>
        </div>
        <a href="#leaveReviewCard" class="btn btn-outline-danger rounded-pill px-3">
          <i class="fa-solid fa-pen-nib me-1"></i> Write a Review
        </a>
      </div>

      <!-- Rating Category Progress Bars (Dynamic) -->
      <% if (hasReviews) { 
          const baseScore = parseFloat(avgScore) || 5.0;
          const ratingBreakdown = [
            { name: "Cleanliness", score: (Math.min(5.0, Math.max(1.0, baseScore * 0.99))).toFixed(1) },
            { name: "Accuracy", score: (Math.min(5.0, Math.max(1.0, baseScore * 0.98))).toFixed(1) },
            { name: "Communication", score: (Math.min(5.0, Math.max(1.0, baseScore * 1.0))).toFixed(1) },
            { name: "Value for Money", score: (Math.min(5.0, Math.max(1.0, baseScore * 0.97))).toFixed(1) },
          ];
      %>
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
          <% for (let cat of ratingBreakdown) { 
              const barPercent = Math.min(100, Math.max(10, Math.round((parseFloat(cat.score) / 5) * 100)));
          %>
            <div class="col">
              <div class="d-flex justify-content-between align-items-center mb-1 small">
                <span class="fw-medium"><%= cat.name %></span>
                <span class="fw-bold"><%= cat.score %></span>
              </div>
              <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-dark" role="progressbar" style="width: <%= barPercent %>%;"></div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- All Reviews Grid -->
      <% if (hasReviews) { %>
        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
          <% for (let review of reviewList) { 
              const authorName = review.author || "Guest Traveler";
              const initials = authorName.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase() || "GT";
          %>
            <div class="col">
              <div class="card review-card h-100 rounded-4 border shadow-sm">
                <div class="card-body p-3">
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                      <div class="avatar-badge bg-primary-subtle text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <%= initials %>
                      </div>
                      <div>
                        <h6 class="fw-bold mb-0 text-dark"><%= authorName %></h6>
                        <small class="text-muted">
                          <span class="badge bg-light text-muted border rounded-pill py-0 px-2" style="font-size: 0.72rem;"><%= review.tripType || "Holiday Stay" %></span>
                          &bull; <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "" %>
                        </small>
                      </div>
                    </div>

                    <div class="star-rating">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <% if(i <= review.rating) { %>
                          <i class="fa-solid fa-star text-warning"></i>
                        <% } else { %>
                          <i class="fa-regular fa-star text-muted"></i>
                        <% } %>
                      <% } %>
                    </div>
                  </div>

                  <p class="card-text text-secondary mb-3 fs-6 leading-relaxed">
                    "<%= review.comment %>"
                  </p>

                  <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <button class="btn btn-sm text-muted p-0" onclick="this.classList.toggle('text-danger'); this.innerHTML = '<i class=\'fa-solid fa-heart me-1\'></i> Helpful';">
                      <i class="fa-regular fa-thumbs-up me-1"></i> Helpful
                    </button>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                      <button class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="return confirm('Delete this review?')">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="text-center py-4 bg-light rounded-4 mb-5 border">
          <i class="fa-regular fa-comments display-5 text-muted mb-2"></i>
          <h5 class="fw-bold">No Reviews Yet</h5>
          <p class="text-muted small mb-0">Have you stayed at this place? Be the first to share your experience!</p>
        </div>
      <% } %>

      <!-- Leave a Review Form Card -->
      <div class="card border-0 shadow-sm rounded-4 p-4" id="leaveReviewCard" style="background-color: var(--bg-light);">
        <div class="d-flex align-items-center gap-2 mb-3">
          <i class="fa-solid fa-pen-to-square text-danger fs-4"></i>
          <div>
            <h5 class="fw-bold m-0">Leave a Review</h5>
            <small class="text-muted">Rate your stay and help fellow wanderers find great experiences</small>
          </div>
        </div>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
          <div class="row g-3 mb-3">
            <!-- Reviewer Name -->
            <div class="col-md-6">
              <label for="reviewAuthor" class="form-label fw-semibold small">Your Name</label>
              <input 
                type="text" 
                id="reviewAuthor" 
                name="review[author]" 
                class="form-control rounded-3" 
                placeholder="e.g. Aditi Roy" 
                value="Guest Traveler"
                required 
              />
            </div>

            <!-- Trip Type -->
            <div class="col-md-6">
              <label for="reviewTripType" class="form-label fw-semibold small">Trip Type</label>
              <select id="reviewTripType" name="review[tripType]" class="form-select rounded-3">
                <option value="Couples Getaway">Couples Getaway</option>
                <option value="Family Vacation">Family Vacation</option>
                <option value="Solo Traveler">Solo Traveler</option>
                <option value="Friends Trip">Friends Trip</option>
                <option value="Business / Remote Work">Business / Remote Work</option>
              </select>
            </div>
          </div>

          <!-- Interactive Star Rating Picker -->
          <div class="mb-3">
            <label class="form-label fw-semibold small d-block mb-1">Overall Rating</label>
            <div class="d-flex align-items-center gap-3">
              <div class="interactive-star-rating" id="starRatingPicker">
                <i class="fa-solid fa-star star-btn active" data-value="1"></i>
                <i class="fa-solid fa-star star-btn active" data-value="2"></i>
                <i class="fa-solid fa-star star-btn active" data-value="3"></i>
                <i class="fa-solid fa-star star-btn active" data-value="4"></i>
                <i class="fa-solid fa-star star-btn active" data-value="5"></i>
              </div>
              <input type="hidden" name="review[rating]" id="ratingInput" value="5" />
              <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill" id="ratingTextBadge">
                5 &bull; Exceptional
              </span>
            </div>
          </div>

          <!-- Comment Textarea -->
          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold small">Your Feedback & Experience</label>
            <textarea 
              name="review[comment]" 
              id="comment" 
              cols="30" 
              rows="4" 
              class="form-control rounded-3" 
              placeholder="What did you love about the location, amenities, and host? Describe your experience..." 
              required
            ></textarea>
            <div class="invalid-feedback">Please write a comment before submitting.</div>
          </div>

          <div class="d-flex justify-content-end">
            <button class="btn btn-theme rounded-pill px-4 py-2 shadow-sm">
              <i class="fa-solid fa-paper-plane me-1"></i> Post Review
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Interactive Star Rating Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const starPicker = document.getElementById("starRatingPicker");
    if (!starPicker) return;

    const stars = starPicker.querySelectorAll(".star-btn");
    const ratingInput = document.getElementById("ratingInput");
    const ratingBadge = document.getElementById("ratingTextBadge");

    const ratingDescriptions = {
      1: "1 • Terrible",
      2: "2 • Poor",
      3: "3 • Average",
      4: "4 • Very Good",
      5: "5 • Exceptional"
    };

    function setStars(val) {
      stars.forEach(s => {
        const starVal = parseInt(s.getAttribute("data-value"));
        if (starVal <= val) {
          s.classList.add("active");
          s.classList.remove("fa-regular");
          s.classList.add("fa-solid");
        } else {
          s.classList.remove("active");
          s.classList.remove("fa-solid");
          s.classList.add("fa-regular");
        }
      });
      ratingInput.value = val;
      if (ratingBadge) {
        ratingBadge.innerText = ratingDescriptions[val] || `${val} Stars`;
      }
    }

    stars.forEach(star => {
      star.addEventListener("click", () => {
        const val = parseInt(star.getAttribute("data-value"));
        setStars(val);
      });
      star.addEventListener("mouseenter", () => {
        const val = parseInt(star.getAttribute("data-value"));
        stars.forEach(s => {
          const sVal = parseInt(s.getAttribute("data-value"));
          s.style.color = sVal <= val ? "#ffb703" : "#d1d5db";
        });
      });
    });

    starPicker.addEventListener("mouseleave", () => {
      const cur = parseInt(ratingInput.value) || 5;
      stars.forEach(s => {
        s.style.color = "";
      });
      setStars(cur);
    });
  });
</script>

<!-- Scripts for Feature 2 Live Calculation, Leaflet Map & Booking Modal -->
<script>
  const pricePerNight = <%= listing.price || 0 %>;
  const cleaningFee = <%= listing.cleaningFee || 500 %>;
  const listingLat = <%= (listing.geometry && listing.geometry.lat) ? listing.geometry.lat : 20.2961 %>;
  const listingLng = <%= (listing.geometry && listing.geometry.lng) ? listing.geometry.lng : 85.8245 %>;

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Initialize Dates
    const today = new Date();
    const future = new Date();
    future.setDate(today.getDate() + 3);

    const todayStr = today.toISOString().split("T")[0];
    const futureStr = future.toISOString().split("T")[0];

    const calcCheckIn = document.getElementById("calcCheckIn");
    const calcCheckOut = document.getElementById("calcCheckOut");

    if (calcCheckIn && calcCheckOut) {
      calcCheckIn.min = todayStr;
      calcCheckIn.value = todayStr;
      calcCheckOut.min = todayStr;
      calcCheckOut.value = futureStr;
    }

    calculateLiveBudget();

    // 2. Initialize Leaflet Map for Single Listing
    const singleMap = L.map('singlePropertyMap').setView([listingLat, listingLng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(singleMap);

    const customMarkerIcon = L.divIcon({
      className: 'custom-single-marker',
      html: `<div class="single-pin-badge"><i class="fa-solid fa-house"></i></div>`,
      iconSize: [36, 36],
      iconAnchor: [18, 18]
    });

    L.marker([listingLat, listingLng], { icon: customMarkerIcon })
      .addTo(singleMap)
      .bindPopup("<b><%= listing.title %></b><br><%= listing.location %>")
      .openPopup();
  });

  function calculateLiveBudget() {
    const cIn = new Date(document.getElementById("calcCheckIn").value);
    const cOut = new Date(document.getElementById("calcCheckOut").value);
    const guests = parseInt(document.getElementById("calcGuests").value) || 2;
    const userBudget = parseFloat(document.getElementById("calcBudget").value) || null;

    let nights = 3;
    if (cIn && cOut && cOut > cIn) {
      nights = Math.ceil((cOut - cIn) / (1000 * 60 * 60 * 24));
    }

    const baseNightlyTotal = pricePerNight * nights;
    const extraGuests = Math.max(0, guests - 2);
    const extraGuestFee = extraGuests * 300 * nights;
    const serviceFee = Math.round(baseNightlyTotal * 0.05);
    const subtotal = baseNightlyTotal + extraGuestFee + cleaningFee + serviceFee;
    const gst = Math.round(subtotal * 0.18);
    const grandTotal = subtotal + gst;

    // Update UI elements
    document.getElementById("labelNightlyCalc").innerText = `₹${pricePerNight.toLocaleString("en-IN")} × ${nights} nights`;
    document.getElementById("valNightlyCalc").innerText = `₹${baseNightlyTotal.toLocaleString("en-IN")}`;

    const extraRow = document.getElementById("extraGuestRow");
    if (extraGuestFee > 0) {
      extraRow.style.setProperty("display", "flex", "important");
      document.getElementById("valExtraGuest").innerText = `+₹${extraGuestFee.toLocaleString("en-IN")}`;
    } else {
      extraRow.style.setProperty("display", "none", "important");
    }

    document.getElementById("valCleaningFee").innerText = `₹${cleaningFee.toLocaleString("en-IN")}`;
    document.getElementById("valServiceFee").innerText = `₹${serviceFee.toLocaleString("en-IN")}`;
    document.getElementById("valGst").innerText = `₹${gst.toLocaleString("en-IN")}`;
    document.getElementById("valGrandTotal").innerText = `₹${grandTotal.toLocaleString("en-IN")}`;

    // Budget fit badge
    const badge = document.getElementById("budgetFitBadge");
    if (userBudget) {
      badge.classList.remove("d-none");
      if (grandTotal <= userBudget) {
        const savings = userBudget - grandTotal;
        badge.className = "alert alert-success py-2 px-3 small rounded-3 mb-3";
        badge.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> <b>Fits Your Budget!</b> You save ₹${savings.toLocaleString("en-IN")}`;
      } else {
        const over = grandTotal - userBudget;
        badge.className = "alert alert-danger py-2 px-3 small rounded-3 mb-3";
        badge.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i> <b>Exceeds Budget</b> by ₹${over.toLocaleString("en-IN")}`;
      }
    } else {
      badge.classList.add("d-none");
    }
  }

  // Open booking modal pre-filled with calculator data
  function openBookingModal() {
    const calcIn = document.getElementById("calcCheckIn").value;
    const calcOut = document.getElementById("calcCheckOut").value;
    const calcG = document.getElementById("calcGuests").value;

    const modalIn = document.getElementById("modalCheckIn");
    const modalOut = document.getElementById("modalCheckOut");
    const modalG = document.getElementById("modalGuests");

    const todayStr = new Date().toISOString().split("T")[0];
    if (modalIn) {
      modalIn.min = todayStr;
      modalIn.value = calcIn || todayStr;
    }
    if (modalOut) {
      modalOut.min = modalIn.value || todayStr;
      modalOut.value = calcOut || "";
    }
    if (modalG && calcG) {
      modalG.value = calcG;
    }

    syncModalDates();

    const bookingModalEl = document.getElementById("bookingModal");
    const modal = new bootstrap.Modal(bookingModalEl);
    modal.show();
  }

  // Sync pricing within modal
  function syncModalDates() {
    const mIn = new Date(document.getElementById("modalCheckIn").value);
    const mOut = new Date(document.getElementById("modalCheckOut").value);
    const guests = parseInt(document.getElementById("modalGuests").value) || 2;

    let nights = 1;
    if (mIn && mOut && mOut > mIn) {
      nights = Math.ceil((mOut - mIn) / (1000 * 60 * 60 * 24));
    }

    const baseTotal = pricePerNight * nights;
    const extraGuests = Math.max(0, guests - 2);
    const extraGuestFee = extraGuests * 300 * nights;
    const serviceFee = Math.round(baseTotal * 0.05);
    const subtotal = baseTotal + extraGuestFee + cleaningFee + serviceFee;
    const gst = Math.round(subtotal * 0.18);
    const grandTotal = subtotal + gst;

    const modalNightlyLabel = document.getElementById("modalNightlyLabel");
    const modalNightlyVal = document.getElementById("modalNightlyVal");
    const modalExtraGuestRow = document.getElementById("modalExtraGuestRow");
    const modalExtraGuestVal = document.getElementById("modalExtraGuestVal");
    const modalServiceFeeVal = document.getElementById("modalServiceFeeVal");
    const modalGstVal = document.getElementById("modalGstVal");
    const modalGrandTotalVal = document.getElementById("modalGrandTotalVal");

    if (modalNightlyLabel) modalNightlyLabel.innerText = `₹${pricePerNight.toLocaleString("en-IN")} × ${nights} night${nights > 1 ? 's' : ''}`;
    if (modalNightlyVal) modalNightlyVal.innerText = `₹${baseTotal.toLocaleString("en-IN")}`;

    if (modalExtraGuestRow) {
      if (extraGuestFee > 0) {
        modalExtraGuestRow.style.display = "flex";
        if (modalExtraGuestVal) modalExtraGuestVal.innerText = `+₹${extraGuestFee.toLocaleString("en-IN")}`;
      } else {
        modalExtraGuestRow.style.display = "none";
      }
    }

    if (modalServiceFeeVal) modalServiceFeeVal.innerText = `₹${serviceFee.toLocaleString("en-IN")}`;
    if (modalGstVal) modalGstVal.innerText = `₹${gst.toLocaleString("en-IN")}`;
    if (modalGrandTotalVal) modalGrandTotalVal.innerText = `₹${grandTotal.toLocaleString("en-IN")}`;
  }

  // Client-side bootstrap form validation for booking modal
  (() => {
    'use strict'
    const bookingForm = document.getElementById('bookingForm');
    if (bookingForm) {
      bookingForm.addEventListener('submit', event => {
        if (!bookingForm.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        bookingForm.classList.add('was-validated');
      }, false);
    }
  })();
</script>
