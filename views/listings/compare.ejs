<% layout("/layouts/boilerplate") %>

<div class="compare-page-container py-3">
  <!-- Header -->
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
      <span class="badge bg-warning-subtle text-dark px-3 py-2 rounded-pill fw-semibold mb-2">
        <i class="fa-solid fa-code-compare me-1 text-warning"></i> Side-by-Side Evaluator
      </span>
      <h2 class="fw-bold display-6 mb-1">Compare Properties Side by Side</h2>
      <p class="text-muted fs-6 mb-0">Evaluate total pricing, guest limits, amenities, and cancellation policies at a glance.</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary rounded-pill" onclick="clearCompareList(); window.location.href='/listings/compare';">
        <i class="fa-solid fa-trash-can me-1"></i> Clear All
      </button>
      <a href="/listings" class="btn btn-theme rounded-pill px-3">
        <i class="fa-solid fa-plus me-1"></i> Add More Stays
      </a>
    </div>
  </div>

  <% if (listings.length < 2) { %>
    <!-- State when fewer than 2 properties are selected -->
    <div class="card border-0 shadow-sm rounded-4 text-center p-5 mb-5">
      <div class="mb-3">
        <i class="fa-solid fa-scale-balanced text-muted" style="font-size: 3.5rem;"></i>
      </div>
      <h4 class="fw-bold">Select At Least 2 Stays to Compare</h4>
      <p class="text-muted mx-auto" style="max-width: 500px;">
        You currently have <b><%= listings.length %></b> property selected. Click "Add to Compare" on any of the featured stays below or explore the full catalog.
      </p>

      <div class="row row-cols-1 row-cols-md-3 g-3 mt-4 text-start">
        <% for(let feat of featuredListings.slice(0, 3)) { %>
          <div class="col">
            <div class="card h-100 border shadow-sm rounded-3 overflow-hidden">
              <img 
                src="<%= feat.image && feat.image.url ? feat.image.url : '' %>" 
                class="card-img-top" 
                style="height: 140px; object-fit: cover;" 
                alt="<%= feat.title %>"
              />
              <div class="card-body p-3">
                <h6 class="fw-bold text-truncate mb-1"><%= feat.title %></h6>
                <p class="text-muted small mb-2"><%= feat.location %>, <%= feat.country %></p>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold text-dark">&#8377;<%= feat.price ? feat.price.toLocaleString("en-IN") : 'N/A' %>/night</span>
                  <button 
                    class="btn btn-sm btn-outline-danger rounded-pill px-3"
                    onclick="toggleCompare('<%= feat._id %>', '<%= feat.title.replace(/'/g, '') %>', '<%= feat.image && feat.image.url ? feat.image.url : '' %>', <%= feat.price || 0 %>); window.location.reload();"
                  >
                    + Add to Compare
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <!-- Comparison Matrix Table -->
    <div class="table-responsive card border-0 shadow-sm rounded-4 p-3 mb-5">
      <table class="table table-bordered align-middle compare-table mb-0">
        <!-- 1. Header with Photo & Title -->
        <thead>
          <tr class="table-light">
            <th style="width: 20%; min-width: 180px;" class="fw-bold text-muted text-uppercase small">Property Feature</th>
            <% for(let item of listings) { %>
              <th style="width: <%= Math.floor(80 / listings.length) %>%; min-width: 240px;" class="text-center position-relative">
                <button 
                  class="btn btn-sm btn-light border rounded-circle position-absolute top-0 end-0 m-2"
                  title="Remove from comparison"
                  onclick="toggleCompare('<%= item._id %>', '', '', 0); window.location.href = removeIdFromQuery('<%= item._id %>');"
                >
                  &times;
                </button>
                <img 
                  src="<%= item.image && item.image.url ? item.image.url : '' %>" 
                  alt="<%= item.title %>" 
                  class="img-fluid rounded-3 mb-2 shadow-sm" 
                  style="height: 150px; width: 100%; object-fit: cover;"
                />
                <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>"><%= item.title %></h6>
                <span class="badge bg-light text-muted border"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= item.location %>, <%= item.country %></span>
              </th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <!-- 2. Nightly Price -->
          <tr>
            <td class="fw-bold text-muted small"><i class="fa-solid fa-tag text-primary me-2"></i> Nightly Rate</td>
            <% for(let item of listings) { %>
              <td class="text-center">
                <span class="fs-5 fw-bold text-dark">&#8377;<%= item.price ? item.price.toLocaleString("en-IN") : 'N/A' %></span>
                <span class="text-muted small">/ night</span>
              </td>
            <% } %>
          </tr>

          <!-- 3. Total 3-Night Estimated Cost -->
          <tr class="table-primary-subtle">
            <td class="fw-bold text-dark small">
              <i class="fa-solid fa-calculator text-primary me-2"></i> 3-Night Trip Total (Taxes & Fees)
            </td>
            <% for(let item of listings) { 
                const base3 = (item.price || 0) * 3;
                const clean = item.cleaningFee || 500;
                const serv = item.serviceFee || Math.round(base3 * 0.05);
                const sub = base3 + clean + serv;
                const gst = Math.round(sub * 0.18);
                const total3 = sub + gst;
            %>
              <td class="text-center">
                <span class="fs-5 fw-bold text-danger">&#8377;<%= total3.toLocaleString("en-IN") %></span>
                <div class="text-muted small" style="font-size: 0.75rem;">Includes base + clean + 18% GST</div>
              </td>
            <% } %>
          </tr>

          <!-- 4. Community Rating & Reviews -->
          <tr>
            <td class="fw-bold text-muted small"><i class="fa-solid fa-star text-warning me-2"></i> Guest Rating</td>
            <% for(let item of listings) { 
                const count = item.reviews ? item.reviews.length : 0;
                const avg = count > 0 
                  ? (item.reviews.reduce((acc, r) => acc + r.rating, 0) / count).toFixed(1) 
                  : "New";
            %>
              <td class="text-center">
                <span class="fw-bold text-warning"><i class="fa-solid fa-star"></i> <%= avg %></span>
                <span class="text-muted small">(<%= count %> reviews)</span>
              </td>
            <% } %>
          </tr>

          <!-- 5. Property Type & Guest Limit -->
          <tr>
            <td class="fw-bold text-muted small"><i class="fa-solid fa-house text-success me-2"></i> Stay Style & Capacity</td>
            <% for(let item of listings) { %>
              <td class="text-center">
                <div class="fw-semibold"><%= item.propertyType || "Apartment" %></div>
                <div class="text-muted small">Accommodates up to <b><%= item.maxGuests || 4 %> guests</b></div>
              </td>
            <% } %>
          </tr>

          <!-- 6. Amenities Checklist Comparison -->
          <% 
            const compareAmenities = [
              { name: "Wifi", label: "High-speed Wi-Fi", icon: "fa-wifi" },
              { name: "Free Parking", label: "Free Vehicle Parking", icon: "fa-square-parking" },
              { name: "Air Conditioning", label: "Air Conditioning (AC)", icon: "fa-snowflake" },
              { name: "Kitchen", label: "Kitchen / Cooking", icon: "fa-utensils" },
              { name: "Swimming Pool", label: "Swimming Pool", icon: "fa-person-swimming" },
              { name: "Dedicated Workspace", label: "Dedicated Workspace", icon: "fa-laptop" },
              { name: "Pet Friendly", label: "Pet Friendly", icon: "fa-paw" },
              { name: "TV", label: "HD TV / Entertainment", icon: "fa-tv" }
            ];
          %>
          <% for(let am of compareAmenities) { %>
            <tr>
              <td class="text-muted small">
                <i class="fa-solid <%= am.icon %> me-2 text-secondary"></i> <%= am.label %>
              </td>
              <% for(let item of listings) { 
                  const hasIt = (item.amenities || []).some(a => a.toLowerCase() === am.name.toLowerCase());
              %>
                <td class="text-center">
                  <% if (hasIt) { %>
                    <span class="badge bg-success-subtle text-success p-2 rounded-circle"><i class="fa-solid fa-check"></i></span>
                  <% } else { %>
                    <span class="text-muted opacity-50">&mdash;</span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% } %>

          <!-- 7. Cancellation Policy -->
          <tr>
            <td class="fw-bold text-muted small"><i class="fa-solid fa-shield-halved text-info me-2"></i> Cancellation Policy</td>
            <% for(let item of listings) { %>
              <td class="text-center small">
                <span class="badge bg-light text-dark border p-2 text-wrap">
                  <%= item.cancellationPolicy || "Flexible (Free cancellation up to 48 hrs)" %>
                </span>
              </td>
            <% } %>
          </tr>

          <!-- 8. Nearby Hubs -->
          <tr>
            <td class="fw-bold text-muted small"><i class="fa-solid fa-compass text-danger me-2"></i> Key Landmarks</td>
            <% for(let item of listings) { %>
              <td class="text-center small">
                <% for(let hub of (item.nearbyHubs || []).slice(0, 2)) { %>
                  <div class="text-muted mb-1"><i class="fa-solid fa-circle-dot text-danger me-1" style="font-size: 0.6rem;"></i> <%= hub %></div>
                <% } %>
              </td>
            <% } %>
          </tr>

          <!-- 9. Final Action Row -->
          <tr class="table-light">
            <td class="fw-bold text-muted small">Next Step</td>
            <% for(let item of listings) { %>
              <td class="text-center">
                <a href="/listings/<%= item._id %>" class="btn btn-theme rounded-pill px-4">
                  View & Book
                </a>
              </td>
            <% } %>
          </tr>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  function removeIdFromQuery(idToRemove) {
    const params = new URLSearchParams(window.location.search);
    const ids = params.get("ids") ? params.get("ids").split(",") : [];
    const newIds = ids.filter(id => id.trim() !== idToRemove.trim());
    if (newIds.length === 0) return "/listings/compare";
    return `/listings/compare?ids=${newIds.join(",")}`;
  }
</script>
