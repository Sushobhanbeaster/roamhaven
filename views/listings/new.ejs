<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-3 mb-5">
  <div class="col-12 col-md-8">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h3 class="fw-bold m-0">Host with RoamHaven</h3>
        <p class="text-muted small mb-0">Publish your space with smart amenities and discovery tags</p>
      </div>
      <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Cancel</a>
    </div>

    <form method="POST" action="/listings" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input 
          name="listing[title]" 
          id="title"
          placeholder="Catchy title for your place" 
          type="text" 
          class="form-control" 
          required 
        />
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea 
          name="listing[description]" 
          id="description"
          placeholder="Describe what makes your space special..." 
          class="form-control" 
          rows="3"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Image URL</label>
        <input 
          name="listing[image]" 
          id="image"
          placeholder="https://images.unsplash.com/..." 
          type="text" 
          class="form-control" 
        />
        <div class="form-text">Leave blank to use a beautiful default home image.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
          <input 
            name="listing[price]" 
            id="price"
            placeholder="2000" 
            type="number" 
            class="form-control" 
            required 
            min="1"
          />
          <div class="invalid-feedback">Price should be a valid positive number.</div>
        </div>

        <div class="mb-3 col-md-4">
          <label for="propertyType" class="form-label fw-semibold">Property Type</label>
          <select name="listing[propertyType]" id="propertyType" class="form-select">
            <option value="Apartment">Apartment</option>
            <option value="Villa">Villa</option>
            <option value="Cottage">Cottage</option>
            <option value="Chalet">Chalet</option>
            <option value="Loft">Loft</option>
            <option value="Treehouse">Treehouse</option>
            <option value="Cabin">Cabin</option>
            <option value="Resort">Resort</option>
            <option value="Ryokan">Ryokan</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="mb-3 col-md-4">
          <label for="maxGuests" class="form-label fw-semibold">Max Guests</label>
          <input 
            name="listing[maxGuests]" 
            id="maxGuests"
            type="number" 
            class="form-control" 
            value="4" 
            min="1" 
            max="20"
          />
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="location" class="form-label fw-semibold">Location / City</label>
          <input 
            name="listing[location]" 
            id="location"
            placeholder="e.g. Bhubaneswar, Malibu, Goa..." 
            type="text" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Location should be valid.</div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input 
            name="listing[country]" 
            id="country"
            placeholder="India" 
            type="text" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Please provide a country name.</div>
        </div>
      </div>

      <!-- Feature 3: Map Coordinates -->
      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="lat" class="form-label fw-semibold">Latitude (for Leaflet Map Pin)</label>
          <input 
            name="lat" 
            id="lat"
            placeholder="20.2961" 
            type="number" 
            step="any"
            value="20.2961"
            class="form-control" 
          />
        </div>

        <div class="mb-3 col-md-6">
          <label for="lng" class="form-label fw-semibold">Longitude (for Leaflet Map Pin)</label>
          <input 
            name="lng" 
            id="lng"
            placeholder="85.8245" 
            type="number" 
            step="any"
            value="85.8245"
            class="form-control" 
          />
        </div>
      </div>

      <!-- Feature 1 & 4: Amenities -->
      <div class="mb-4">
        <label class="form-label fw-semibold d-block">Available Amenities</label>
        <div class="d-flex flex-wrap gap-2">
          <% const allAmenities = ["Wifi", "Free Parking", "Air Conditioning", "Kitchen", "Dedicated Workspace", "Swimming Pool", "Pet Friendly", "TV"]; %>
          <% for(let am of allAmenities) { %>
            <div class="form-check form-check-inline border rounded-pill px-3 py-1 bg-light">
              <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= am %>" id="am_<%= am.replace(/\s+/g, '') %>" checked>
              <label class="form-check-label small" for="am_<%= am.replace(/\s+/g, '') %>"><%= am %></label>
            </div>
          <% } %>
        </div>
      </div>

      <div class="d-grid">
        <button class="btn btn-theme py-2 fs-5 rounded-pill shadow-sm">Publish Listing</button>
      </div>
    </form>
  </div>
</div>

<script>
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>

