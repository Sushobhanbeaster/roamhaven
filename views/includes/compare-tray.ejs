<!-- Floating Compare Stays Tray -->
<div id="compareTray" class="compare-tray shadow-lg d-none">
  <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3">
    <div class="d-flex align-items-center gap-3">
      <div class="compare-badge">
        <i class="fa-solid fa-code-compare text-danger me-1"></i>
        <span class="fw-bold">Compare Stays</span>
        <span id="compareCount" class="badge rounded-pill bg-danger ms-1">0/3</span>
      </div>
      <div id="compareThumbnails" class="d-flex align-items-center gap-2">
        <!-- Rendered dynamically by compare-tray.js -->
      </div>
    </div>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <button id="clearCompareBtn" class="btn btn-sm btn-outline-secondary" onclick="clearCompareList()">
        Clear All
      </button>
      <button id="compareNowBtn" class="btn btn-sm btn-theme px-3" onclick="goToComparisonPage()">
        Compare Now <i class="fa-solid fa-arrow-right ms-1"></i>
      </button>
    </div>
  </div>
</div>
